{
  "name": "reading-os",
  "productName": "Kenning",
  "version": "0.1.0",
  "description": "AI-native, document-first desktop reader that turns hard-to-read PDFs into a clean reading experience.",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node scripts/patch-pdfjs.mjs && node scripts/copy-pdfjs-assets.mjs",
    "dev": "node scripts/setup.mjs && electron-vite dev",
    "build": "node scripts/patch-pdfjs.mjs && node scripts/copy-pdfjs-assets.mjs && electron-vite build",
    "preview": "node scripts/setup.mjs && electron-vite preview",
    "web": "node scripts/copy-pdfjs-assets.mjs && vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "extract": "node --experimental-strip-types --no-warnings scripts/extract.ts",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "slice": "node scripts/slice-pdf.mjs",
    "audit": "node --experimental-strip-types scripts/audit.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.2.5",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@huggingface/transformers": "^3.8.1",
    "fflate": "^0.8.3",
    "kokoro-js": "^1.2.1",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "linkedom": "^0.18.15",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "app.kenning.desktop",
    "productName": "Kenning",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF document",
        "role": "Viewer"
      },
      {
        "ext": "epub",
        "name": "EPUB book",
        "role": "Viewer"
      }
    ],
    "icon": "build/icon.png",
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/onnxruntime-common/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ]
  }
}
